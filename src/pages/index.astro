---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { site, skillGroups } from '../data/site';
import { projects } from '../data/projects';
---
<Layout>
  <section id="home" class="hero container">
    <div class="hero-copy"><p class="eyebrow"><span class="signal"></span> SOFTWARE ENGINEERING → CLOUD & DEVOPS</p>
      <h1>Solid foundations.<br /><span>New horizons.</span></h1>
      <p class="hero-intro">I’m Travis Boyd, a <strong>Lead Software Developer</strong> with a decade of experience building applications. Now expanding that foundation into Azure Cloud and DevOps engineering.</p>
      <div class="hero-actions"><a class="button primary" href="#projects">Explore my projects <Icon /></a><a class="text-link" href="#about">A little about me <span aria-hidden="true">↗</span></a></div>
      <div class="hero-footnote"><span class="small-label">BUILT ON EXPERIENCE</span><span>C# / .NET <i>·</i> Enterprise applications <i>·</i> Technical leadership</span></div>
    </div>
    <div class="engineering-panel" aria-label="Engineering focus: application development, cloud engineering, and infrastructure automation">
      <div class="panel-top mono"><span>ENGINEERING / EVOLVING</span><span class="signal"></span></div>
      <div class="orbit-art" aria-hidden="true"><div class="orbit one"></div><div class="orbit two"></div><div class="orbit three"></div><span class="orbit-dot dot-one"></span><span class="orbit-dot dot-two"></span><div class="core">tb<span>.</span></div><span class="orbit-label label-one">&lt; / &gt; SOFTWARE</span><span class="orbit-label label-two">☁ CLOUD</span><span class="orbit-label label-three">⌘ DEVOPS</span></div>
      <div class="panel-bottom"><span class="mono">A DEVELOPER’S MINDSET.</span><strong>A broader engineering toolkit.</strong></div>
    </div>
  </section>
  <div class="focus-strip"><div class="container"><span class="small-label">THE FOUNDATION</span><span>C# & .NET</span><span>SQL & data</span><span>Web applications</span><span class="strip-next">NEXT CHAPTER <span aria-hidden="true">↗</span> Azure & DevOps</span></div></div>
  <section id="about" class="section container about-section">
    <SectionHeading number="01" label="ABOUT" title="An engineer. Always building." />
    <div class="about-content"><p class="large-copy">A decade in software.<br /><span class="muted">A new perspective on what comes next.</span></p><p>My background is in C#, .NET, and ASP.NET, with approximately 10 years of software development experience. As a Lead Software Developer, I work at the intersection of technical leadership and enterprise application development.</p><p>I’m expanding into Azure Cloud Engineering, DevOps, networking, and infrastructure automation. This portfolio is where I’ll document that work: the projects, the decisions, and what I learn along the way.</p><a class="text-link" href="#resume">Explore my technical background <Icon /></a></div>
  </section>
  <section id="projects" class="section projects-section"><div class="container">
    <div class="section-title-row"><SectionHeading number="02" label="PROJECTS" title="From ideas to implementation." /><p>A working collection of things I’m building<br class="desktop-break" /> and the engineering behind them.</p></div>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
    <p class="project-note"><span class="signal"></span> A portfolio in progress. Each project’s status reflects its documented stage.</p>
  </div></section>
  <section id="resume" class="section container resume-section">
    <div><SectionHeading number="03" label="RÉSUMÉ" title="Experience that carries forward." /><p>Lead Software Developer with approximately 10 years of experience in web and enterprise application development, grounded in the Microsoft .NET ecosystem.</p><p>Bringing a software engineering foundation to an expanding focus on cloud platforms, delivery practices, and infrastructure.</p>{site.resumePdf && <a class="button secondary" href={site.resumePdf}>Download résumé <span aria-hidden="true">↓</span></a>}</div>
    <div class="skills-grid">{skillGroups.map(group => <div class="skill-group"><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div>
  </section>
  <section id="contact" class="container contact-section"><div><p class="eyebrow">04 / CONTACT</p><h2>Good engineering starts<br />with a conversation<span>.</span></h2><p>Connect about software, cloud engineering, or the next interesting problem.</p><a class="email-link" href={`mailto:${site.email}`}>{site.email}<Icon /></a></div><div class="contact-links"><a href={site.github}><Icon name="github" /><span>Find me on GitHub</span><span aria-hidden="true">↗</span></a><a href={`mailto:${site.email}`}><Icon name="mail" /><span>Send an email</span><span aria-hidden="true">↗</span></a>{site.linkedin && <a href={site.linkedin}><span>LinkedIn</span><span aria-hidden="true">↗</span></a>}</div></section>
</Layout>
