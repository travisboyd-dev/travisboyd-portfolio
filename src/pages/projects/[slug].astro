---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
---
<Layout title={`${project.title} — Travis Boyd`} description={project.summary}>
  <article class="container project-detail">
    <a class="text-link" href="/#projects">← All projects</a>
    <div class="detail-heading"><p class="eyebrow">PROJECT {project.number} / {project.category}</p><h1>{project.title}</h1><span class:list={['status', { active: project.status === 'In Progress' }]}><i></i>{project.status}</span><p class="large-copy">{project.summary}</p><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul></div>
    <div class="detail-body"><section><h2>The idea</h2><p>{project.overview}</p>{project.repository && <p><a class="text-link" href={project.repository}>View source on GitHub ↗</a></p>}{project.liveUrl && <p><a class="text-link" href={project.liveUrl}>View project ↗</a></p>}</section><section><h2>Current stage</h2><ul>{project.current.map(item => <li>{item}</li>)}</ul></section><section><h2>What’s next</h2><ul>{project.next.map(item => <li>{item}</li>)}</ul></section></div>
    <a class="button secondary" href="/#contact">Talk engineering →</a>
  </article>
</Layout>
